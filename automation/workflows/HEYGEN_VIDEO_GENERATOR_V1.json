    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst required = ['request_id','project_id','avatar_id','script'];\nconst missing = required.filter((key) => !body[key]);\nif (missing.length) throw new Error('heygen.video.requested missing fields: ' + missing.join(', '));\n\nconst payload = {\n  type: 'avatar',\n  avatar_id: String(body.avatar_id),\n  title: body.title ?? ('Vitrine HeyGen ' + String(body.request_id)),\n  aspect_ratio: body.aspect_ratio ?? '9:16',\n  resolution: body.resolution ?? '1080p',\n  callback_id: String(body.request_id)\n};\n\nif (body.script) payload.script = String(body.script);\nif (body.voice_id) payload.voice_id = String(body.voice_id);\nif (body.audio_url) payload.audio_url = String(body.audio_url);\nif (body.audio_asset_id) payload.audio_asset_id = String(body.audio_asset_id);\nif (body.callback_url) payload.callback_url = String(body.callback_url);\nif (body.motion_prompt) payload.motion_prompt = String(body.motion_prompt);\n\nreturn [{json:{\n  request_id:String(body.request_id),\n  project_id:String(body.project_id),\n  company_id:body.company_id ?? null,\n  idempotency_key:String(body.request_id),\n  heygen_payload:payload\n}}];"
      },
      "id": "heygen-validate-v1",
      "name": "Validate HeyGen Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://core.hml.vitrineiapro.com.br/api/internal/media/avatar-video",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CENTRO_IA_INTERNAL_TOKEN }}"
            },
            {
              "name": "X-Vitrine-Project",
              "value": "={{ $json.project_id }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({event_id:$json.request_id,project_id:$json.project_id,company_id:$json.company_id ?? null,title:$json.heygen_payload.title,script:$json.heygen_payload.script,avatar_id:$json.heygen_payload.avatar_id,voice_id:$json.heygen_payload.voice_id ?? null}) }}",
        "options": {}
      },
      "id": "heygen-create-video-v1",
      "name": "Request Avatar Video from Core",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nreturn [{json:{\n  ok: response.ok !== false,\n  accepted: true,\n  provider: response.provider ?? 'heygen',\n  job_id: response.job_id ?? null,\n  video_id: response.video_id ?? null,\n  status: response.status ?? 'accepted',\n  duplicate: response.duplicate ?? false\n}}];"
      },
      "id": "heygen-normalize-response-v1",
      "name": "Normalize HeyGen Response",
