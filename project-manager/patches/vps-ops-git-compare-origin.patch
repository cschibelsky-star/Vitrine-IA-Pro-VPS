+
+
+@router.get("/{project_id}/git/compare-origin", dependencies=[Depends(auth)])
+def project_git_compare_origin(project_id: str, branch: str = "") -> dict[str, Any]:
+    manifest = load_manifest(project_id)
+    _, repository, _ = project_paths(manifest)
+    if not (repository / ".git").is_dir():
+        raise HTTPException(status_code=422, detail="repository_not_git")
+
+    target_branch = str(branch or manifest["repository"].get("branch", "main") or "main").strip()
+    allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._/-"
+    if not target_branch or any(ch not in allowed for ch in target_branch):
+        raise HTTPException(status_code=422, detail="invalid_branch")
+
+    origin = run(["git", "remote", "get-url", "origin"], repository)
+    if not origin["ok"]:
+        return {"ok": False, "project_id": project_id, "stage": "origin", "result": origin}
+
+    fetch = run(["git", "fetch", "--prune", "origin", target_branch], repository)
+    if not fetch["ok"]:
+        return {"ok": False, "project_id": project_id, "stage": "fetch", "result": fetch}
+
+    local_head = run(["git", "rev-parse", "HEAD"], repository)
+    remote_head = run(["git", "rev-parse", f"origin/{target_branch}"], repository)
+    counts = run(["git", "rev-list", "--left-right", "--count", f"HEAD...origin/{target_branch}"], repository)
+    status = run(["git", "status", "--porcelain=v1"], repository)
+
+    ahead = behind = None
+    if counts["ok"]:
+        parts = counts["stdout"].strip().split()
+        if len(parts) == 2:
+            ahead, behind = int(parts[0]), int(parts[1])
+
+    dirty = bool(status["stdout"].strip()) if status["ok"] else None
+    relation = "unknown"
+    if ahead is not None and behind is not None:
+        if ahead == 0 and behind == 0:
+            relation = "clean" if not dirty else "dirty"
+        elif ahead > 0 and behind == 0:
+            relation = "ahead"
+        elif ahead == 0 and behind > 0:
+            relation = "behind"
+        else:
+            relation = "diverged"
+
+    outcome = {
+        "ok": True,
+        "project_id": project_id,
+        "branch": target_branch,
+        "origin": origin["stdout"].strip(),
+        "local_head": local_head["stdout"].strip() if local_head["ok"] else None,
+        "remote_head": remote_head["stdout"].strip() if remote_head["ok"] else None,
+        "ahead": ahead,
+        "behind": behind,
+        "dirty": dirty,
+        "relation": relation,
+        "status": status["stdout"][-20000:],
+        "fetch_performed": True,
+        "worktree_modified": False,
+    }
+    audit("project_git_compare_origin", project_id, {"branch": target_branch}, outcome)
+    return outcome
 
 
