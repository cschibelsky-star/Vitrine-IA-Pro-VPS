{
  "id": "tvsumare",
  "name": "TV Sumaré",
  "workspace_root": "/srv/tvsumare",
  "repository": {
    "url": "https://github.com/cschibelsky-star/TVSUMARE_ENTERPRISE.git",
    "branch": "main",
    "directory": "repository"
  },
  "legacy": {
    "provider": "hostgator",
    "remote_path": "public_html",
    "snapshot_directory": "snapshots/hostgator"
  },
  "shared_directories": [
    "data",
    "uploads",
    "videos",
    "logs",
    "cache",
    "secrets"
  ],
  "docker": {
    "compose_file": "docker-compose.vps.yml",
    "project_name": "tvsumare"
  },
  "domains": {
    "homologation": ["tv-hml.vitrineiapro.com.br"],
    "production": ["tvsumare.com.br", "www.tvsumare.com.br"]
  },
  "release": {
    "directory": "releases",
    "exclude": [
      ".git",
      ".env",
      "shared",
      "data",
      "uploads",
      "videos",
      "logs",
      "vendor",
      "node_modules"
    ]
  }
}
