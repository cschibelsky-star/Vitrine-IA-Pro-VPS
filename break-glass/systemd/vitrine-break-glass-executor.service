[Unit]
Description=Vitrine IA Pro Break Glass Executor
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/vitrine-break-glass/executor.py
Restart=on-failure
RestartSec=5
Environment=BREAK_GLASS_EXECUTOR_SOCKET=/run/break-glass/executor.sock
Environment=BREAK_GLASS_EXECUTOR_AUDIT_LOG=/var/log/vitrine-break-glass/executor-audit.jsonl
Environment=BREAK_GLASS_RELEASES_FILE=/etc/vitrine-break-glass/releases.json
Environment=BREAK_GLASS_V5_CONTAINER=vitrine_mcp_v5
RuntimeDirectory=break-glass
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/break-glass /var/log/vitrine-break-glass

[Install]
WantedBy=multi-user.target
